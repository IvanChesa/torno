# Torno: configuración del servidor (Apache o LiteSpeed de Banahosting). PLAN fase 4, tarea 2.
#
# Angular copia este archivo tal cual al build (dist/torno/browser/.htaccess). Después,
# scripts/htaccess.mjs (postbuild) cambia el marcador de `script-src` por los hashes SHA-256 de los
# scripts en línea del HTML prerenderizado y comprueba que cada archivo del build cae en su regla
# de caché.
# El servidor local de los e2e (scripts/serve-static.mjs) aplica las mismas cabeceras: los e2e del
# build corren bajo esta CSP.
#
# Sin <IfModule> en lo imprescindible (reescritura y cabeceras): si al servidor le faltara un
# módulo, mejor un error que se ve en el staging que una web sin CSP.

Options -Indexes -MultiViews
DirectoryIndex index.html
# Las URLs van sin barra final: /sobre-el-proyecto sirve sobre-el-proyecto/index.html.
DirectorySlash Off
ErrorDocument 404 /404/index.html

# --- Tipos MIME ---------------------------------------------------------------------------------
AddDefaultCharset utf-8
AddType text/javascript .js .mjs
AddType text/css .css
AddType image/svg+xml .svg
AddType font/woff2 .woff2
AddType text/plain .txt
AddCharset utf-8 .js .mjs .css .svg .txt

# --- URLs -----------------------------------------------------------------------------------------
RewriteEngine On

# HTTPS obligatorio: el micrófono y el AudioWorklet solo funcionan en un contexto seguro.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Sin barra final: /ruta/ → /ruta (la raíz se queda igual).
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /ruta → ruta/index.html (las páginas prerenderizadas).
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ /$1/index.html [L]

# Nada que empiece por punto (el estado del despliegue por FTP, .htaccess…).
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# --- Cabeceras de seguridad -------------------------------------------------------------------------
# CSP: los scripts, solo del propio sitio y los en línea con su hash (los pone el build). El
# worklet (addModule) cuenta como script; los workers de síntesis y de exportación, como worker.
# Los estilos en línea son los de los componentes de Angular. Las descargas por blob: no
# dependen de la CSP.
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' __SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; media-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
Header always set Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=(), usb=()"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "DENY"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set Cross-Origin-Resource-Policy "same-origin"
Header always set Strict-Transport-Security "max-age=31536000"

# --- Caché ------------------------------------------------------------------------------------------
# Con hash en el nombre (main-XXXXXXXX.js, chunk-…, styles-…, worker-…, media/…-XXXXXXXX.woff2 y
# audio/processor.XXXXXXXX.js): no cambian nunca.
<FilesMatch "[.-][A-Za-z0-9_-]{8}\.(js|css|woff2)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# El HTML, siempre revalidado: cada build cambia los nombres de lo que carga.
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache"
</FilesMatch>

# El resto (favicon, licencias): un día.
<FilesMatch "\.(svg|txt|ico|png|webp)$">
  Header set Cache-Control "public, max-age=86400"
</FilesMatch>

# --- Compresión (si el servidor la tiene; LiteSpeed comprime por su cuenta) -------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml text/plain application/json
</IfModule>
