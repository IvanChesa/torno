{
  "name": "torno",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "node scripts/build-worklet.mjs --watch -- ng serve",
    "build": "ng build",
    "prebuild": "node scripts/build-worklet.mjs",
    "postbuild": "node scripts/publish-licenses.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:node && npm run test:ng",
    "pretest": "node scripts/build-worklet.mjs",
    "test:node": "vitest run --config vitest.node.config.mts --coverage --exclude \"**/*.bench.spec.ts\"",
    "test:bench": "vitest run --config vitest.node.config.mts bench.spec",
    "test:ng": "ng test --watch=false",
    "typecheck": "tsc -p tsconfig.pure.json && tsc -p tsconfig.worklet.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "lint": "npm run typecheck && ng lint && prettier --check .",
    "prelint": "node scripts/build-worklet.mjs",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "pree2e": "node scripts/build-worklet.mjs && node scripts/make-fake-mic.mjs",
    "capturas": "node scripts/capture.mjs",
    "check": "npm run lint && npm test && npm run build && node scripts/check-bundles.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.0"
  }
}
